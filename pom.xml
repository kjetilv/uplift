<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.kjetilv.uplift</groupId>
  <artifactId>uplift</artifactId>
  <version>0.1.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>uplift</name>
  <description>Uplift</description>
  <url>https://github.com/kjetilv/uplift</url>

  <licenses>
    <license>
      <name>GNU General Public License v3.0</name>
      <url>https://raw.githubusercontent.com/kjetilv/uplift/refs/heads/main/LICENSE</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/kjetilv/uplift</connection>
    <developerConnection>scm:git:https://github.com/kjetilv/uplift</developerConnection>
    <url>https://github.com/kjetilv/uplift</url>
  </scm>

  <!--
    No parent. This repository is a git submodule of taninim-comp but must build on its
    own, so it carries its own configuration rather than inheriting from the aggregator.
  -->

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <!--
      Preview features and the vector API are needed at compile time and at test runtime.
      Preview class files only run on the exact same JDK feature version.
    -->
    <!--
      Deliberately not named uplift.*: the uplift plugin has its own
      uplift.addModules parameter for the native image, and a shared name would
      silently feed this value to native-image, which the Gradle build never did.
    -->
    <jvm.addModules>jdk.incubator.vector</jvm.addModules>

    <junit.version>6.0.3</junit.version>
    <assertj.version>3.27.7</assertj.version>

    <compiler.plugin.version>3.14.0</compiler.plugin.version>
    <surefire.plugin.version>3.6.0</surefire.plugin.version>
    <source.plugin.version>3.3.1</source.plugin.version>
    <jar.plugin.version>3.4.2</jar.plugin.version>
    <shade.plugin.version>3.6.1</shade.plugin.version>
    <exec.plugin.version>3.6.1</exec.plugin.version>

    <st4.version>4.3.4</st4.version>
    <awssdk.version>2.34.2</awssdk.version>
    <plugin.tools.version>3.15.2</plugin.tools.version>
  </properties>

  <!-- Maven derives build order from dependencies, so this list is only for grouping. -->
  <modules>
    <module>uplift-util</module>
    <module>uplift-flogs</module>
    <module>uplift-json-anno</module>
    <module>uplift-hash</module>
    <module>uplift-json</module>
    <module>uplift-json-gen</module>
    <module>uplift-edam</module>
    <module>uplift-edamame</module>
    <module>uplift-json-mame</module>
    <module>uplift-json-match</module>
    <module>uplift-kernel</module>
    <module>uplift-s3</module>
    <module>uplift-synchttp</module>
    <module>uplift-lambda</module>
    <module>uplift-flambda</module>
    <module>uplift-fq</module>
    <module>uplift-json-samplegen</module>
    <module>uplift-json-jmh</module>
    <module>uplift-synchttp-jmh</module>

    <!-- Build logic, shared by the Gradle tasks and the Maven mojos. -->
    <module>uplift-plugin-core</module>
    <module>uplift-maven-plugin</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    Gradle applied these to every subproject through a subprojects {} block. Maven has no
    equivalent, so they are inherited test dependencies instead.
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <compilerArgs>
              <arg>--enable-preview</arg>
              <arg>--add-modules</arg>
              <arg>${jvm.addModules}</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.plugin.version}</version>
          <configuration>
            <!-- -ea matches Gradle's Test task, which enables assertions by default. -->
            <argLine>-ea --enable-preview --add-modules ${jvm.addModules}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${source.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <!-- Gradle produced a sources jar for every module through withSourcesJar(). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/kjetilv/uplift</url>
    </repository>
  </distributionManagement>

</project>
