<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.github.kjetilv.uplift</groupId>
    <artifactId>uplift</artifactId>
    <version>0.1.1-SNAPSHOT</version>
  </parent>

  <artifactId>uplift-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>

  <name>uplift-maven-plugin</name>
  <description>Builds native lambdas and lifts them to the cloud</description>

  <properties>
    <maven.api.version>3.9.9</maven.api.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-plugin-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${plugin.tools.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${plugin.tools.version}</version>
        <configuration>
          <!--
            Without this the prefix would be derived as "uplift" from the artifact id and
            the goals would read `uplift:uplift-deploy`. Set explicitly so goals are named
            `uplift:deploy`, `uplift:ping` and so on.
          -->
          <goalPrefix>uplift</goalPrefix>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
