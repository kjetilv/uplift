<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.github.kjetilv.uplift.examples</groupId>
    <artifactId>hello-web</artifactId>
    <version>0.1.1-SNAPSHOT</version>
  </parent>

  <artifactId>hello-web-service</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-kernel</artifactId>
      <version>${uplift.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-lambda</artifactId>
      <version>${uplift.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-util</artifactId>
      <version>${uplift.version}</version>
    </dependency>

    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-flambda</artifactId>
      <version>${uplift.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.github.kjetilv.uplift</groupId>
        <artifactId>uplift-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>native-lambda</id>
            <goals>
              <goal>native-lambda</goal>
            </goals>
            <configuration>
              <main>helloweb</main>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
